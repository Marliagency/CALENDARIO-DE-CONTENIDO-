# Copia este archivo como .env.local en la raíz del monorepo.
# NUNCA commitees .env.local — ya está en .gitignore.

# Base de datos — SQLite en dev (file relativo al cwd del proceso = services/api)
DATABASE_URL="file:./dev.db"

# Crypto — generar con: openssl rand -base64 32
JWT_SECRET="dev-only-jwt-secret-change-me"
ENCRYPTION_KEY="dev-only-encryption-key-32bytes!!"

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# OAuth — rellenar cuando se configuren los App Reviews
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT="http://localhost:3000/api/v1/oauth/instagram/callback"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_OAUTH_REDIRECT="http://localhost:3000/api/v1/oauth/tiktok/callback"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT="http://localhost:3000/api/v1/oauth/youtube/callback"

# Modo simulación de publicación. Con valor "1", las "publicaciones" de los jobs
# no se envían a las plataformas — se marcan como publicadas en BD y se generan
# métricas dummy. Útil para probar el flujo entero sin App Review aprobado.
PULSE_SIMULATE_PUBLISH=1

# ─── Upload-Post (capa unificada de publicación, sin App Review) ────────────
# Una sola API key sirve para TikTok, Instagram, Facebook, YouTube, LinkedIn,
# X/Twitter, Threads, Pinterest, Reddit, Bluesky. Crea perfiles en
# https://app.upload-post.com y conecta ahí las cuentas. Después asigna un
# perfil a cada workspace con UPLOAD_POST_PROFILE_<SLUG_UPPER>.
UPLOAD_POST_API_KEY=""
UPLOAD_POST_API_BASE="https://api.upload-post.com"
UPLOAD_POST_PROFILE_QYRO="qyro-main"
UPLOAD_POST_PROFILE_PERSONAL="diego-personal"
UPLOAD_POST_PROFILE_MARLI_AGENCY="marli-agency"

# Flags de desarrollo / tests
# PULSE_DISABLE_JOBS=1         # desactiva el job runner
# PULSE_DISABLE_RATE_LIMIT=1   # desactiva el rate limiting (tests)
