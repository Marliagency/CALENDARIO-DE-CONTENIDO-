# Copy to .env.studio (gitignored). Used by `pnpm --filter @pulse/studio studio`.

# ─── Pulse ─────────────────────────────────────────────────────
PULSE_API_BASE_URL=http://localhost:3000
PULSE_WORKSPACE_SLUG=qyro
# Fallback API key if no per-workspace key is set:
PULSE_API_KEY=

# ─── Per-workspace API keys ────────────────────────────────────
# One per workspace. The studio resolves <SLUG_UPPER>_PULSE_API_KEY first,
# then falls back to PULSE_API_KEY. Generate at /w/<slug>/settings/api-keys
# with scopes: ingest, read_brain.
QYRO_PULSE_API_KEY=
PERSONAL_PULSE_API_KEY=
MARLI_AGENCY_PULSE_API_KEY=

# ─── Higgsfield (paid video / image) ───────────────────────────
HIGGSFIELD_MONTHLY_CREDIT_BUDGET=500
HIGGSFIELD_WARN_AT_PCT=70
HIGGSFIELD_BLOCK_PREMIUM_AT_PCT=90

# ─── Free generators ───────────────────────────────────────────
GEMINI_API_KEY=           # https://aistudio.google.com — used by mcp-image
ELEVENLABS_API_KEY=       # free tier: 10k chars/mo
PLETOR_API_KEY=

# ─── Studio paths (optional overrides) ─────────────────────────
# STUDIO_LOGS_DIR=studio/logs
# STUDIO_PENDING_PATH=studio/pending-pushes.jsonl
# STUDIO_RENDERS_DIR=studio/renders
